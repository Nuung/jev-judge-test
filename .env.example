# 서버 전용 키이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다. cp .env.example .env 후 값을 채운다.
TYPESAFE_API_KEY=
# pnpm bench의 Claude 비교 모델에만 필요하다(없으면 해당 모델을 건너뛴다)
ANTHROPIC_API_KEY=
# pnpm bench의 OpenAI 비교 모델(gpt-6-luna, gpt-6-sol)에만 필요하다(없으면 해당 모델을 건너뛴다). 선택.
OPENAI_API_KEY=
# pnpm bench의 옵션 데이터셋 WildGuardMix에만 필요하다(없으면 해당 데이터셋만 건너뛴다). 선택.
HF_TOKEN=
